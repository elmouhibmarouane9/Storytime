# Copy to .env and fill in. Never commit .env.

# REQUIRED — the gate in front of your ledger. Anyone with this code sees your money.
# Generate one:  openssl rand -hex 12
MIM_ACCESS_CODE=change-me-before-you-go-public

# Only needed for the https profile (docker compose --profile https up -d).
# Point an A record at your server first.
MIM_DOMAIN=ops.yourdomain.com
MIM_EMAIL=you@yourdomain.com

# Optional
TZ=Europe/Madrid
# Public Hugging Face model ID used by the optional local draft-polishing feature.
# Inference runs on this device; first use downloads model files. No API token is used.
MIM_LOCAL_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct
